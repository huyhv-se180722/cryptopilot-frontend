# Public browser configuration only. Never put secrets in VITE_* variables.
# Backend REST base including the version, e.g. http://localhost:8080/api/v1 with the backend dev
# profile (CORS allows any localhost origin there). Blank keeps every backend feature unavailable.
VITE_API_BASE_URL=
VITE_WS_URL=
# Only effective in Vite development mode; never included in a production build.
VITE_ENABLE_DEV_FIXTURES=false
# Demo trading screens (/trade/**); keep false until the backend merges its paper module.
VITE_ENABLE_PAPER_TRADING=false
